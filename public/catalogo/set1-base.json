  {
   "id": "tanque",
   "nome": "Tanque",
   "descricao": "Linha de frente que segura o dano pelo time. (2) +20% de armadura e resistência mágica; (4) +40%, e começam a luta com escudo de 15% da vida; (6) +70%, e no começo da luta provocam: os inimigos em volta atacam o Tanque por 3 segundos."
  },
  {
   "id": "porradeiro",
   "nome": "Porradeiro",
   "descricao": "Briga corpo a corpo: muita vida e bate mais forte quando apanha. (2) +15% de vida máxima; (4) +30%, e abaixo de metade da vida causam 20% a mais de dano; (6) +50%, e o resto do time ganha +10% de vida."
  },
  {
   "id": "assassino",
   "nome": "Assassino",
   "descricao": "No começo da luta saltam pra trás da linha inimiga e vão atrás de quem tem menos vida. (2) +15% de chance e +15% de dano de crítico; (4) +30% e +30%; (6) +45% e +45%, e cada abate deixa o Assassino 1 segundo sem poder ser alvo."
  },
  {
   "id": "fogo",
   "nome": "Fogo",
   "descricao": "Elemento, classe reserva (um por unidade). Os ataques queimam: o alvo perde vida aos poucos e recebe menos cura. (2) queimadura fraca; (4) média; (6) forte, e quem morre queimando passa o fogo pro inimigo mais perto."
  },
  {
   "id": "agua",
   "nome": "Água",
   "descricao": "Elemento, classe reserva (um por unidade). Recuperam vida durante a luta. (2) 1% da vida por segundo; (4) 2%; (6) 3%, e a cada 4 segundos se livram de queimadura, lentidão e outros efeitos ruins."
  },
  {
   "id": "terra",
   "nome": "Terra",
   "descricao": "Elemento, classe reserva (um por unidade). Pele de pedra. (2) +15% de armadura; (4) +30%; (6) +50%, e a cada 6 segundos um tremor atordoa por meio segundo os inimigos em volta."
  },
  {
   "id": "vento",
   "nome": "Vento",
   "descricao": "Elemento, classe reserva (um por unidade). Rápidos e difíceis de acertar. (2) +15% de velocidade de ataque; (4) +30%, e desviam de 10% dos ataques; (6) +50%, e desviam de 20%."
  },
  {
   "id": "raio",
   "nome": "Raio",
   "descricao": "Elemento, classe reserva (um por unidade). A cada 3 ataques, um raio pula do alvo pra outros inimigos. (2) pula pra 1; (4) pra 2; (6) pra 3, e atordoa por meio segundo quem leva."
  },
  {
   "id": "gelo",
   "nome": "Gelo",
   "descricao": "Elemento, classe reserva (um por unidade). Os ataques deixam o alvo mais lento. (2) ele ataca 15% mais devagar; (4) 25%; (6) 35%, e o 5º ataque seguido no mesmo alvo congela ele por 1 segundo."
  },
  {
   "id": "planta",
   "nome": "Planta",
   "descricao": "Elemento, classe reserva (um por unidade). O primeiro ataque em cada inimigo planta uma semente que suga a vida dele e cura quem plantou. (2) semente fraca; (4) média; (6) forte, e a cura vai também pro aliado mais perto."
  },
  {
   "id": "luz",
   "nome": "Luz",
   "descricao": "Elemento, classe reserva (um por unidade). Os ataques ofuscam: por 2 segundos o alvo erra parte dos ataques. (2) erra 15%; (4) 25%; (6) 40%."
  },
  {
   "id": "trevas",
   "nome": "Trevas",
   "descricao": "Elemento, classe reserva (um por unidade). Batem mais forte em quem está ferido. (2) +10% de dano em inimigos abaixo de metade da vida; (4) +20%; (6) +30%, e acabam com quem fica abaixo de 10% da vida."
  }
 ],
